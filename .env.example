# Telegram Bot (via @BotFather) und Chat-ID (z.B. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option A: Klassifikation läuft über die claude-CLI (Claude Pro/Max-Abo),
# kein separater Anthropic-API-Key nötig.
#
# Einmalig in einem eigenen (interaktiven!) Terminal ausführen:
#   claude setup-token
# Den ausgegebenen Token hier eintragen. Damit funktioniert die
# Authentifizierung auch unbeaufsichtigt per Cron, ohne dass ein
# Login-Browserfenster nötig wird.
CLAUDE_CODE_OAUTH_TOKEN=

# Absoluter Pfad zur claude-Binary. Cron hat ein sehr minimales PATH und
# findet "claude" sonst evtl. nicht - `which claude` im Terminal prüfen.
CLAUDE_BINARY=/opt/homebrew/bin/claude

# Claude-Modell-Alias für die Anzeigen-Klassifikation (z.B. sonnet, haiku, opus)
CLAUDE_MODEL=sonnet

# Kommagetrennte Suchbegriffe für kleinanzeigen.de
SEARCH_QUERIES=mamiya 645,mamiya sekor

# Gesuchter Brennweitenbereich für Festbrennweiten (in mm)
MIN_FOCAL_LENGTH_MM=35
MAX_FOCAL_LENGTH_MM=150

# Wartezeit zwischen Requests an kleinanzeigen.de (Sekunden, Höflichkeit)
REQUEST_DELAY_SECONDS=1.5
